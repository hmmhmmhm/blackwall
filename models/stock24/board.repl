    memLdoSetup: true
    coreLdoReduction: true
    buckStartStorage: true
    buckOverrideStorage: true
    mramControlStorage: true
    halStorage: true
    memoryStartup: true
    chipRevision: 35
    spotStorage: true
    shadowInfo1: "mram"
    startupControls: true
    powerMode: "lp"
    resetLatch: 2
    size: 0x23000

