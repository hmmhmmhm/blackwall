rtc_model: Miscellaneous.BlackwallRtcAdapter @ none
    halLowUpperWrites: true
    independentWeekday: true
    -> nvic@2

pointerProbe: Miscellaneous.BlackwallPmicTimedProbe @ iom7 0x6b
    vbusStatusProfile: "test-vbus-absent"
    timerProfile: "fast-reset-stopped"
    ldswState: "source-reset-storage"
    buckState: "source-reset-storage"
    chargerStatusProfile: "source-reset-snapshot"
    ntcCode: 512
    dieTempCode: 466
    vsysCode: 611
    vbusCode: 0
    resultResetProfile: "source-reset"
    measurementProfile: "queued-six-channel-fixture"
    vbatCode: 778
    ibatCode: 5
    scratchState: "guest-storage"
    scratch0InitialMock: 0
    adcState: "source-reset-storage"
    vbusState: "guest-storage"

stimer_model: Miscellaneous.BlackwallStimerClockCounter @ none
    profile: "nominal-source-clocks"
    IRQA -> nvic@32
    IRQB -> nvic@33
    IRQC -> nvic@34
    IRQD -> nvic@35
    IRQE -> nvic@36
    IRQF -> nvic@37
    IRQG -> nvic@38
    IRQH -> nvic@39
    IRQI -> nvic@40

mspi1_power: Miscellaneous.BlackwallPeripheralPower @ none
    mask: 0x8000
    profile: 1
    offProfile: 0

mspi1_clock: Miscellaneous.BlackwallMspi1ClockStorage @ none
    mspi0Storage: true
    profile: "source-reset-storage"

mspi1_config: Miscellaneous.BlackwallMspi1ConfigStorage @ none
    profile: "source-reset-config"
    xipRestoreStorage: true
    cqInputLevels: 0
    xipMixedStorage: true
    xipTurnaroundStorage: true
    pio: mspi1_pio
    interrupts: mspi1_interrupts
    xipGuard: xip_guard
    commandQueueInit: true

xip_guard: Miscellaneous.BlackwallMspi1XipGuard @ sysbus 0x80000000
    fontHeaderProfile: "missing-font-magic-only"
    primaryHeaderReadPc: 0x47605a
    secondaryHeaderReadPc: 0x476134
    power: mspi1_power
    clock: mspi1_clock

mspi1_interrupts: Miscellaneous.BlackwallMspi1Interrupts @ none
    profile: "source-reset"
    allowAllClear: true
    IRQ -> nvic@21

timer14: Miscellaneous.BlackwallTimer14 @ none
    idleChannelControls: true
    profile: "nominal-xt-lfrc"
    timer0Profile: "nominal-hfrc96-upcount"
    timer7Profile: "nominal-hfrc96-pwm"
    Timer7IRQ -> nvic@74
    Timer0IRQ -> nvic@67
    IRQ -> nvic@81

mspi1_pio: Miscellaneous.BlackwallMspi1PioReset @ none
    profile: "idle-nor-reset"
    continuousStatusRead: true
    pageProgramMicroseconds: 1000
    completePageProgram: true
    sectorEraseMicroseconds: 1000
    completeSectorErase: true
    maxArrayReadBytes: 4096
    arrayBacking: nor_read_window
    configurationByte: 0
    emulateWriteEnableLatch: true
    statusByte: 64
    samplingProfile: "ideal-sdr"
    identityProfile: "mx25u25643g"
    power: mspi1_power
    clock: mspi1_clock
    interrupts: mspi1_interrupts
    completeTransactions: true

gpio_role_input: Miscellaneous.BlackwallGpioRoleInput @ none
