    interrupts: true
    txInterruptQuirks: false
    IRQ -> nvic@17

uart3_adapter: Miscellaneous.BlackwallUartAdapter
    module: 3
    interrupts: true
    txInterruptQuirks: false
    IRQ -> nvic@18

adc_trigger: Miscellaneous.BlackwallAdcInternalTrigger
    sourceHz: 24000000

iom2_power: Miscellaneous.BlackwallPeripheralPower
    mask: 0x8
    profile: 1
    offProfile: 0

iom2: Miscellaneous.BlackwallStrictIom @ sysbus 0x40052000
