crypto_otp_lifecycle: Miscellaneous.BlackwallCryptoOtpPowerLifecycle @ none
    readiness: otp_read_readiness

nor_read_window: Miscellaneous.BlackwallNorReadWindow @ none
    profile: "erased-range"
    start: 0x1fc0000
    length: 0x40000
    additionalWindow: littlefs_blank_volume
    allowSectorErase: true
    allowPageProgram: true

littlefs_blank_volume: Miscellaneous.BlackwallNorReadWindow @ none
    profile: "erased-range"
    start: 0x1400000
    length: 0xbc0000
    allowSectorErase: true
    allowPageProgram: true

